# Copia este archivo como agente/.env y complétalo en tu computadora.
# agente/.env NO se sube a GitHub ni a Vercel. Nunca pegues estas claves en un chat.

# --- Usuario del CRM con el que trabaja el agente (el mismo correo y contraseña con los que entras al CRM)
CRM_EMAIL=
CRM_PASSWORD=

# --- Correo de CPP desde el que se envía (Gmail o Google Workspace)
CORREO_CPP=
# Contraseña de aplicación de Google (16 letras), NO la contraseña normal del correo.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
CORREO_CLAVE_APP=
# Nombre y apellido que firman los correos
NOMBRE_REMITENTE=José Santana

# --- Ritmo de envío (un correo nuevo debe empezar despacio para no caer en spam)
LIMITE_DIARIO=15
ENVIOS_POR_CICLO=3
# Hora de Lima, de 9:00 a 18:00, de lunes (1) a sábado (6)
HORARIO=9-18
DIAS=1-6
DIAS_PARA_SEGUIMIENTO=5
MINUTOS_ENTRE_CICLOS=10

# --- Claude (usa tu suscripción de Claude Code; no hace falta clave de API)
BORRADORES_POR_CICLO=5
MAX_POR_APROBAR=20
LLAMADAS_CLAUDE_POR_DIA=60
# Opcional: sonnet, opus... Vacío = el modelo por defecto de tu plan
MODELO_CLAUDE=
